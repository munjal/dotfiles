export VISUAL='emacsclient -c'
export EDITOR='vim'
export ERL_AFLAGS="-kernel shell_history enabled"

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/sbin
export PATH=$HOME/.cargo/bin:$PATH

